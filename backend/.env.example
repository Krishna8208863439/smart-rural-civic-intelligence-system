PORT=5000

# =======================================================
# MONGODB CONFIGURATION
# =======================================================
# Option A: Local MongoDB (Default)
MONGODB_URI=mongodb://127.0.0.1:27017/srci_db

# Option B: Cloud MongoDB Atlas (Paste your Atlas connection URI here)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/srci_db?retryWrites=true&w=majority

JWT_SECRET=srci_jwt_secret_production_ready_rural_intelligence_2025
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Cloudinary (Optional - system automatically falls back to local disk storage if not configured)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
